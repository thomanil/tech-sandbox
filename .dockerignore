.git
__pycache__/
*.pyc
.venv/
# Qt client + docs aren't needed in the server image.
app/client-python-qt/
README.md
# The web client's source IS in the build context (the web-build stage needs it),
# but its install/build artifacts must not be — they'd bloat the context and the
# image rebuilds them from the lockfile anyway.
app/client-web/node_modules/
app/client-web/dist/
# Generated by the web-build stage inside the image; never ship a local copy.
app/server-python/static/
