/.idea/
/__pycache__/
/app/client-python-qt/__pycache__/
# Generated by the Vite build (Dockerfile bakes it into the image; a local
# `vite build` may emit it here for `uv run` to serve). Never committed.
/app/server-python/static/
/app/server-python/__pycache__/

# UpCloud cluster kubeconfig — holds cluster-admin creds. It lives OUTSIDE the
# repo (~/.secrets/tech-sandbox-upcloud-k8s-cluster_kubeconfig.yaml) for local
# deploys; CI reads it from the UPCLOUD_KUBECONFIG Actions secret. This defensive
# glob just guards against ever dropping a kubeconfig into the working tree.
*kubeconfig*.yaml
