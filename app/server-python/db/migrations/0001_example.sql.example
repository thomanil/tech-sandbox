-- EXAMPLE / TEMPLATE — not applied.
--
-- yoyo only loads *.sql (and *.py) files, so this *.sql.example file is inert.
-- To create the first real migration, copy it to a real name (drop ".example"),
-- e.g. 0001_create_timeline_state.sql, and write the matching rollback in
-- 0001_create_timeline_state.rollback.sql. See README.md for conventions.
--
-- The server applies whatever real migrations exist here on startup
-- (run_migrations() in ../../timeline_server.py).

-- Example "up" SQL (what would go in 0001_create_timeline_state.sql):
--
--   CREATE TABLE timeline_state (
--       client_id   BIGINT PRIMARY KEY,
--       sequence    TEXT   NOT NULL,
--       position    INTEGER NOT NULL,
--       playing     BOOLEAN NOT NULL DEFAULT FALSE,
--       updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()
--   );
--
-- And its rollback (0001_create_timeline_state.rollback.sql):
--
--   DROP TABLE timeline_state;
